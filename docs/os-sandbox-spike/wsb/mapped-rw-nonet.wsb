<!-- Windows Sandbox 样例:读写映射 + 禁网。
     注意:禁网后 LLM 供应商 API 不可达,与需要模型的 agent 节点互斥;
     仅适合不需要网络的纯本地 CLI 型任务。 -->
<Configuration>
  <Networking>Disable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\atlas-worktree</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
</Configuration>
