<!-- Windows Sandbox 样例:只读映射工作目录(agent writable:false 语义的隔离层对应物)。
     需 Windows Pro/Enterprise + 已启用"Windows 沙盒"功能;双击或 WindowsSandbox.exe 执行。 -->
<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\atlas-worktree</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
</Configuration>
